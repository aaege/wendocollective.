<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — Wendo 2.0 Merch</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

    :root {
      --bg: #FAF3BA;
      --surface: #FFFBEF;
      --surface-2: #F3E9A8;
      --text: #2A0D0D;
      --muted: #8C4A3A;
      --burgundy: #D70000;
      --burgundy-strong: #9E0000;
      --marigold: #F8DF01;
      --marigold-text: #A8600A;
      --line: rgba(42,13,13,.15);
      --line-strong: rgba(42,13,13,.3);
      --focus: #D70000;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #1A0505; --surface: #2A0A0A; --surface-2: #3A0E0E;
        --text: #FAF3BA; --muted: #D9A8A0;
        --burgundy: #FF3B3B; --burgundy-strong: #C41E1E;
        --marigold: #FFE94D; --marigold-text: #FFC93C;
        --line: rgba(250,243,186,.15); --line-strong: rgba(250,243,186,.3);
        --focus: #FFE94D;
      }
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Schibsted Grotesk', system-ui, sans-serif;
      line-height: 1.55;
    }
    .mono { font-family: 'IBM Plex Mono', monospace; }
    h1, h2, h3 { font-family: 'Luckiest Guy', sans-serif; font-weight: 400; margin: 0; }
    .ribbon {
      height: 10px;
      background: repeating-linear-gradient(90deg,
        var(--burgundy) 0 18px, var(--marigold) 18px 36px, var(--surface) 36px 54px);
    }
    .site-nav {
      background: var(--burgundy-strong);
      padding: .9rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid rgba(0,0,0,.25);
    }
    .nav-brand { font-family: 'IBM Plex Mono', monospace; font-size: .85rem; color: var(--marigold); text-transform: uppercase; letter-spacing: .08em; }
    .nav-back { color: #F8EFD8; text-decoration: none; font-family: 'IBM Plex Mono', monospace; font-size: .8rem; }
    .nav-back:hover { color: var(--marigold); text-decoration: underline; }

    .wrap { max-width: 820px; margin: 2.5rem auto; padding: 0 1.25rem; }
    .checkout-card {
      background: var(--surface);
      border: 1px solid var(--line-strong);
      box-shadow: 0 16px 36px rgba(42,13,13,.12);
      padding: 2rem;
    }
    .checkout-head { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
    .checkout-head h1 { font-size: 2.2rem; color: var(--burgundy); }
    .checkout-head p { color: var(--muted); margin: .4rem 0 0; }

    .item-summary {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: 1.5rem;
      background: var(--surface-2);
      border: 1px solid var(--line);
      padding: 1.25rem;
      margin-bottom: 2rem;
    }
    .item-img { width: 140px; height: 140px; object-fit: cover; border: 1px solid var(--line-strong); background: #000; }
    .item-details h3 { font-size: 1.4rem; color: var(--text); }
    .item-cat { font-family: 'IBM Plex Mono', monospace; font-size: .75rem; color: var(--marigold-text); text-transform: uppercase; }
    .item-price { font-family: 'Luckiest Guy', sans-serif; font-size: 1.4rem; color: var(--burgundy); margin: .5rem 0; }

    .form-group { margin-bottom: 1.4rem; }
    .form-group label {
      display: block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .8rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      margin-bottom: .4rem;
      color: var(--text);
      font-weight: 600;
    }
    .form-control, select, textarea {
      width: 100%;
      padding: .85rem 1rem;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: .95rem;
    }
    .form-control:focus, select:focus, textarea:focus {
      outline: 2px solid var(--burgundy);
    }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }

    .order-summary {
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      padding: 1.25rem 1.5rem;
      margin: 1.5rem 0 2rem;
    }
    .summary-line {
      display: flex;
      justify-content: space-between;
      margin-bottom: .6rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .9rem;
    }
    .summary-total {
      display: flex;
      justify-content: space-between;
      border-top: 1px solid var(--line-strong);
      padding-top: .75rem;
      font-family: 'Luckiest Guy', sans-serif;
      font-size: 1.6rem;
      color: var(--burgundy);
    }

    .btn-submit {
      width: 100%;
      display: block;
      background: var(--marigold);
      color: #241209;
      border: 2px solid var(--marigold);
      padding: 1.1rem 2rem;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 700;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: .06em;
      cursor: pointer;
      transition: transform .2s ease, background .2s ease;
    }
    .btn-submit:hover {
      background: #ebd200;
      transform: translateY(-2px);
    }
    .pesapal-badge {
      text-align: center;
      margin-top: 1rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      color: var(--muted);
    }

    @media (max-width: 600px) {
      .item-summary { grid-template-columns: 1fr; }
      .grid-2 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <nav class="site-nav">
    <span class="nav-brand">Wendo Collective Presents · 2.0 Drop</span>
    <a class="nav-back" href="/">← Back to Wendo 2.0</a>
  </nav>
  <div class="ribbon"></div>

  <div class="wrap">
    <div class="checkout-card">
      <div class="checkout-head">
        <h1>Order Checkout</h1>
        <p>Complete your official Wendo 2.0 merchandise order. Powered by Pesapal payment gateway.</p>
      </div>

      <div class="item-summary">
        <div>
          <% if (product.image_path) { %>
            <img id="checkoutCoverImg" class="item-img" src="<%= product.image_path %>" alt="<%= product.name %>">
          <% } %>
          <% if (product.images && product.images.length > 1) { %>
            <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap; max-width:140px;">
              <% product.images.forEach(function(imgUrl, idx) { %>
                <img src="<%= imgUrl %>" alt="Thumbnail" class="checkout-thumb-item" style="width:30px; height:30px; object-fit:cover; cursor:pointer; border:1px solid <%= idx === 0 ? 'var(--marigold)' : 'var(--line)' %>; border-radius:2px;" onclick="document.getElementById('checkoutCoverImg').src = '<%= imgUrl %>'; document.querySelectorAll('.checkout-thumb-item').forEach(el => el.style.borderColor = 'var(--line)'); this.style.borderColor = 'var(--marigold)';">
              <% }); %>
            </div>
          <% } %>
        </div>
        <div class="item-details">
          <span class="item-cat"><%= product.category %></span>
          <h3><%= product.name %></h3>
          <p style="margin: .3rem 0; font-size: .9rem; color: var(--muted);"><%= product.description %></p>
          <div class="item-price"><%= formatPrice(product.price_kes) %></div>
        </div>
      </div>

      <form action="/pesapal/process-order" method="POST" id="order-form">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <input type="hidden" name="unit_price" id="unit-price" value="<%= product.price_kes %>">

        <div class="grid-2">
          <% if (product.sizes && product.sizes.trim()) { %>
            <div class="form-group">
              <label for="size">Select Size</label>
              <select name="size" id="size" required>
                <% product.sizes.split(',').forEach(function(s) { %>
                  <option value="<%= s.trim() %>"><%= s.trim() %></option>
                <% }); %>
              </select>
            </div>
          <% } else { %>
            <input type="hidden" name="size" value="One Size">
          <% } %>

          <div class="form-group">
            <label for="quantity">Quantity</label>
            <select name="quantity" id="quantity" onchange="updateTotal()">
              <option value="1">1</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5">5</option>
            </select>
          </div>
        </div>

        <div class="grid-2">
          <div class="form-group">
            <label for="customer_name">Full Name</label>
            <input type="text" class="form-control" id="customer_name" name="customer_name" placeholder="Wangari Maathai" required>
          </div>
          <div class="form-group">
            <label for="customer_phone">Phone Number (M-Pesa)</label>
            <input type="tel" class="form-control" id="customer_phone" name="customer_phone" placeholder="0712 345 678" required>
          </div>
        </div>

        <div class="form-group">
          <label for="customer_email">Email Address</label>
          <input type="email" class="form-control" id="customer_email" name="customer_email" placeholder="you@domain.com" required>
        </div>

        <div class="form-group">
          <label for="delivery_address">Delivery Address / Pick-up Instructions</label>
          <textarea class="form-control" id="delivery_address" name="delivery_address" rows="2" placeholder="e.g. Kentmere Club Festival Gate or delivery address in Nairobi" required></textarea>
        </div>

        <div class="order-summary">
          <div class="summary-line">
            <span>Item Price</span>
            <span><%= formatPrice(product.price_kes) %></span>
          </div>
          <div class="summary-line">
            <span>Quantity</span>
            <span id="summary-qty">1</span>
          </div>
          <div class="summary-total">
            <span>Total to Pay</span>
            <span id="summary-total"><%= formatPrice(product.price_kes) %></span>
          </div>
        </div>

        <button type="submit" class="btn-submit" id="submit-btn">Proceed to Pesapal Payment (KES <%= Number(product.price_kes).toLocaleString() %>)</button>
        <p class="pesapal-badge">🔒 Secure payment via Pesapal (Cards, M-Pesa, Airtel Money supported)</p>
      </form>
    </div>
  </div>

  <script>
    function updateTotal() {
      const unit = parseFloat(document.getElementById('unit-price').value) || 0;
      const qty = parseInt(document.getElementById('quantity').value, 10) || 1;
      const total = unit * qty;
      document.getElementById('summary-qty').textContent = qty;
      document.getElementById('summary-total').textContent = 'KES ' + total.toLocaleString();
      document.getElementById('submit-btn').textContent = 'Proceed to Pesapal Payment (KES ' + total.toLocaleString() + ')';
    }
  </script>
</body>
</html>
