<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wendo CMS: Products &amp; Storefront</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');

    :root {
      --bg: #140303;
      --surface: #220808;
      --surface-2: #2E0B0B;
      --surface-3: #3B1010;
      --text: #FAF3BA;
      --muted: #D9A8A0;
      --burgundy: #FF3B3B;
      --burgundy-strong: #9E0000;
      --marigold: #F8DF01;
      --marigold-hover: #e5cd00;
      --line: rgba(250,243,186,.18);
      --line-strong: rgba(250,243,186,.35);
      --green: #2ea44f;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Schibsted Grotesk', system-ui, sans-serif;
      line-height: 1.5;
      min-height: 100vh;
    }
    .mono { font-family: 'IBM Plex Mono', monospace; }
    h1, h2, h3 { font-family: 'Luckiest Guy', sans-serif; font-weight: 400; letter-spacing: .02em; }

    .site-nav {
      background: var(--surface);
      padding: .9rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .nav-brand {
      font-family: 'IBM Plex Mono', monospace;
      color: var(--marigold);
      font-weight: 700;
      font-size: .95rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .nav-links a {
      color: #FAF3BA;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .8rem;
      text-decoration: none;
      margin-left: 1.4rem;
      transition: color .15s;
    }
    .nav-links a:hover { color: var(--marigold); }

    .wrap {
      max-width: 1140px;
      margin: 2rem auto 4rem;
      padding: 0 1.25rem;
    }

    /* Flash alerts */
    .alert-banner {
      background: rgba(46, 164, 79, 0.2);
      border: 1px solid var(--green);
      color: #92e6a3;
      padding: .85rem 1.25rem;
      margin-bottom: 1.5rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Products & Inventory Card (Target selector: div:nth-of-type(1) > div:nth-of-type(1)) */
    .card {
      background: var(--surface);
      border: 1px solid var(--line);
      box-shadow: 0 16px 36px rgba(0,0,0,.45);
      padding: 1.75rem;
      margin-bottom: 2.25rem;
    }

    .card-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
      flex-wrap: wrap;
      gap: 1rem;
    }
    .card-title-group h2 {
      color: var(--marigold);
      font-size: 1.95rem;
      margin-bottom: .3rem;
    }
    .card-title-group p {
      color: var(--muted);
      font-size: .88rem;
    }
    .card-count-badge {
      display: inline-block;
      margin-left: .5rem;
      padding: .2rem .55rem;
      background: rgba(248, 223, 1, 0.15);
      color: var(--marigold);
      border: 1px solid rgba(248, 223, 1, 0.3);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      vertical-align: middle;
      font-weight: 600;
    }

    /* Buttons */
    .btn-add-product {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .75rem 1.4rem;
      background: var(--marigold);
      color: #241209;
      border: 2px solid var(--marigold);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      cursor: pointer;
      transition: all .2s ease;
      box-shadow: 0 4px 12px rgba(248, 223, 1, 0.2);
    }
    .btn-add-product:hover {
      background: var(--marigold-hover);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(248, 223, 1, 0.35);
    }

    /* Table styling */
    .table-container {
      overflow-x: auto;
      border: 1px solid var(--line);
      background: var(--surface-2);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    th {
      background: rgba(0,0,0,.35);
      padding: .9rem 1rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--muted);
      border-bottom: 2px solid var(--line);
    }
    td {
      padding: 1rem;
      border-bottom: 1px solid var(--line);
      font-size: .9rem;
      vertical-align: middle;
    }

    /* Clickable product row */
    tr.product-row {
      cursor: pointer;
      transition: background-color .15s ease;
    }
    tr.product-row:hover {
      background: rgba(248, 223, 1, 0.06);
    }
    tr.product-row:hover td.col-name strong {
      color: var(--marigold);
    }

    .prod-thumb {
      width: 54px;
      height: 54px;
      object-fit: cover;
      border: 1px solid var(--line);
      background: #000;
      display: block;
    }
    .col-name strong {
      display: block;
      font-size: 1rem;
      color: var(--text);
      transition: color .15s;
    }
    .col-name .prod-desc-snippet {
      font-size: .78rem;
      color: var(--muted);
      max-width: 260px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: .2rem;
    }
    .size-pill {
      display: inline-block;
      padding: .2rem .45rem;
      background: rgba(250, 243, 186, 0.1);
      border: 1px solid rgba(250, 243, 186, 0.2);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      color: var(--text);
      margin: .1rem .2rem .1rem 0;
      white-space: nowrap;
    }
    .badge {
      display: inline-block;
      padding: .3rem .65rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
    }
    .badge-green {
      background: rgba(46, 164, 79, 0.25);
      color: #92e6a3;
      border: 1px solid rgba(46, 164, 79, 0.5);
    }
    .badge-gray {
      background: rgba(217, 168, 160, 0.15);
      color: var(--muted);
      border: 1px solid rgba(217, 168, 160, 0.3);
    }

    /* Actions */
    .actions-cluster {
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .btn-action {
      padding: .45rem .75rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      font-weight: 700;
      border: 1px solid transparent;
      cursor: pointer;
      text-decoration: none;
      transition: all .15s ease;
      white-space: nowrap;
    }
    .btn-edit {
      background: var(--marigold);
      color: #241209;
      border-color: var(--marigold);
    }
    .btn-edit:hover {
      background: var(--marigold-hover);
    }
    .btn-toggle {
      background: rgba(250,243,186,.1);
      color: var(--text);
      border-color: var(--line);
    }
    .btn-toggle:hover {
      background: rgba(250,243,186,.2);
    }
    .btn-delete {
      background: rgba(255, 59, 59, 0.15);
      color: #ff9b9b;
      border-color: rgba(255, 59, 59, 0.3);
    }
    .btn-delete:hover {
      background: #ff3b3b;
      color: #fff;
    }

    /* MODAL DIALOG */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1.5rem;
      overflow-y: auto;
    }
    .modal-backdrop.open {
      display: flex;
    }
    /* Targeted Focus Mode Selector & Base Modal Card */
    div#productModal:nth-of-type(2) > div:nth-of-type(1),
    .modal-card {
      background: #180404;
      border: 1px solid rgba(250, 243, 186, 0.22);
      border-radius: 12px;
      box-shadow: 0 24px 70px rgba(0,0,0,0.88);
      width: 100%;
      max-width: 680px;
      max-height: 90vh;
      overflow-y: auto;
      padding: 1.75rem 2rem;
      position: relative;
      animation: modalEnter .2s ease-out;
    }
    @keyframes modalEnter {
      from { opacity: 0; transform: scale(.96); }
      to { opacity: 1; transform: scale(1); }
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 1rem;
      margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }
    .modal-head h3 {
      font-size: 1.6rem;
      color: var(--marigold);
      margin-bottom: .25rem;
    }
    .modal-subtitle {
      font-size: .8rem;
      color: var(--muted);
      margin: 0;
      font-family: 'Schibsted Grotesk', sans-serif;
    }
    .btn-close {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--muted);
      font-size: 1.3rem;
      line-height: 1;
      padding: .35rem .65rem;
      cursor: pointer;
      border-radius: 4px;
      transition: color .15s, border-color .15s, background .15s;
    }
    .btn-close:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.06); }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-bottom: 1.25rem;
    }
    .form-group {
      margin-bottom: 1.25rem;
    }
    .form-group label {
      display: block;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .8rem;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--text);
      font-weight: 600;
      margin-bottom: .45rem;
    }
    .form-group .hint {
      font-size: .78rem;
      color: var(--muted);
      margin-top: .25rem;
    }
    .form-control {
      width: 100%;
      padding: .75rem 1rem;
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      color: var(--text);
      font-family: inherit;
      font-size: .95rem;
    }
    .form-control:focus {
      outline: 2px solid var(--marigold);
      background: var(--surface-3);
    }

    /* Size Picker Component */
    .size-picker-box {
      background: var(--surface-2);
      border: 1px solid var(--line);
      padding: 1rem;
      margin-bottom: .5rem;
    }
    .size-chips-grid {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      margin-bottom: .85rem;
    }
    .chip-size {
      padding: .5rem .85rem;
      background: rgba(250, 243, 186, 0.08);
      border: 1px solid var(--line-strong);
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .85rem;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      transition: all .15s ease;
    }
    .chip-size:hover {
      background: rgba(248, 223, 1, 0.18);
      border-color: var(--marigold);
    }
    .chip-size.active {
      background: var(--marigold);
      color: #241209;
      border-color: var(--marigold);
      font-weight: 700;
      transform: scale(1.03);
    }
    .size-presets {
      display: flex;
      gap: .4rem;
      margin-bottom: .6rem;
      flex-wrap: wrap;
    }
    .btn-preset {
      padding: .2rem .5rem;
      background: transparent;
      border: 1px solid var(--line);
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .7rem;
      cursor: pointer;
    }
    .btn-preset:hover {
      color: var(--marigold);
      border-color: var(--marigold);
    }

    /* Category presets */
    .cat-presets {
      display: flex;
      gap: .35rem;
      flex-wrap: wrap;
      margin-top: .4rem;
    }
    .btn-cat-preset {
      padding: .2rem .5rem;
      background: rgba(250, 243, 186, 0.06);
      border: 1px solid var(--line);
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      cursor: pointer;
    }
    .btn-cat-preset:hover {
      color: var(--marigold);
      border-color: var(--marigold);
    }

    /* Image Gallery & Main Photo Arrangement */
    .gallery-manager-box {
      background: #110202;
      border: 1px solid rgba(250, 243, 186, 0.16);
      border-radius: 8px;
      padding: 1.1rem;
      transition: border-color .15s ease, background .15s ease;
    }
    .gallery-manager-box.drag-active {
      border-color: var(--marigold);
      background: rgba(248, 223, 1, 0.06);
    }
    .gallery-notice {
      display: flex;
      align-items: flex-start;
      gap: .6rem;
      background: rgba(248, 223, 1, 0.08);
      border: 1px solid rgba(248, 223, 1, 0.25);
      padding: .65rem .85rem;
      border-radius: 6px;
      margin-bottom: .85rem;
      font-size: .78rem;
      color: var(--text);
      line-height: 1.4;
    }
    .gallery-notice strong {
      color: var(--marigold);
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: .75rem;
      margin-bottom: .85rem;
    }
    .gallery-card {
      background: #1d0606;
      border: 1px solid var(--line);
      border-radius: 6px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      transition: border-color .15s, box-shadow .15s;
    }
    .gallery-card.is-main {
      border: 2px solid var(--marigold);
      box-shadow: 0 0 16px rgba(248, 223, 1, 0.25);
      background: #250909;
    }
    .badge-main-cover {
      display: block;
      width: 100%;
      background: var(--marigold);
      color: #241209;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .65rem;
      font-weight: 700;
      text-align: center;
      padding: .2rem 0;
      text-transform: uppercase;
      letter-spacing: .05em;
    }
    .badge-pos {
      display: block;
      width: 100%;
      background: rgba(250, 243, 186, 0.08);
      color: var(--muted);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .65rem;
      font-weight: 600;
      text-align: center;
      padding: .2rem 0;
    }
    .gallery-img-wrap {
      width: 100%;
      height: 100px;
      background: #000;
      overflow: hidden;
      position: relative;
    }
    .gallery-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .gallery-actions {
      display: flex;
      gap: 3px;
      padding: 4px;
      background: rgba(0, 0, 0, 0.55);
      border-top: 1px solid var(--line);
      align-items: center;
      justify-content: space-between;
    }
    .btn-set-main {
      flex: 1;
      padding: .25rem .3rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .65rem;
      background: rgba(248, 223, 1, 0.12);
      border: 1px solid var(--marigold);
      color: var(--marigold);
      cursor: pointer;
      border-radius: 3px;
      font-weight: 600;
      white-space: nowrap;
      text-align: center;
      transition: all .15s ease;
    }
    .btn-set-main:hover {
      background: var(--marigold);
      color: #241209;
    }
    .btn-order-arrow {
      width: 24px;
      height: 24px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(250, 243, 186, 0.08);
      border: 1px solid var(--line);
      color: var(--text);
      font-size: .7rem;
      cursor: pointer;
      border-radius: 3px;
      transition: background .15s;
    }
    .btn-order-arrow:hover:not(:disabled) {
      background: var(--line-strong);
      color: #fff;
    }
    .btn-order-arrow:disabled {
      opacity: .25;
      cursor: not-allowed;
    }
    .btn-del-img {
      width: 24px;
      height: 24px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 82, 82, 0.15);
      border: 1px solid rgba(255, 82, 82, 0.35);
      color: #ff8888;
      font-size: .75rem;
      cursor: pointer;
      border-radius: 3px;
      transition: all .15s ease;
    }
    .btn-del-img:hover {
      background: #ff5252;
      color: #fff;
      border-color: #ff5252;
    }
    .toolbar-buttons {
      display: flex;
      gap: .6rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .btn-tool {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .45rem .85rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: all .15s ease;
    }
    .btn-tool-upload {
      background: rgba(248, 223, 1, 0.12);
      border: 1px solid var(--marigold);
      color: var(--marigold);
    }
    .btn-tool-upload:hover {
      background: var(--marigold);
      color: #241209;
    }
    .btn-tool-gallery {
      background: rgba(250, 243, 186, 0.06);
      border: 1px solid var(--line);
      color: var(--text);
    }
    .btn-tool-gallery:hover {
      border-color: var(--marigold);
      color: var(--marigold);
    }
    .asset-presets-tray {
      display: flex;
      gap: .45rem;
      flex-wrap: wrap;
      padding: .65rem;
      background: #0b0101;
      border: 1px solid var(--line);
      border-radius: 6px;
      margin-top: .6rem;
    }
    .preset-pill-card {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .25rem .55rem;
      background: rgba(250, 243, 186, 0.05);
      border: 1px solid var(--line);
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all .15s ease;
    }
    .preset-pill-card:hover {
      border-color: var(--marigold);
      background: rgba(248, 223, 1, 0.12);
      color: var(--marigold);
    }
    .preset-pill-card img {
      width: 24px;
      height: 24px;
      border-radius: 3px;
      object-fit: cover;
    }
    .upload-status-indicator {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      color: var(--marigold);
      margin-left: .4rem;
    }

    /* Availability Toggle Box */
    .avail-box {
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      padding: .65rem .85rem;
      display: flex;
      align-items: center;
      gap: .75rem;
      cursor: pointer;
      user-select: none;
      transition: all .15s ease;
    }
    .avail-box:hover {
      border-color: var(--marigold);
    }
    .avail-box.active {
      border-color: rgba(34, 197, 94, 0.4);
      background: rgba(34, 197, 94, 0.08);
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: .8rem;
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line);
    }
    .btn-cancel {
      padding: .85rem 1.5rem;
      background: transparent;
      border: 1px solid var(--line-strong);
      color: var(--text);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .85rem;
      cursor: pointer;
    }
    .btn-cancel:hover { background: rgba(250,243,186,.1); }
    .btn-save {
      padding: .85rem 2rem;
      background: var(--marigold);
      color: #241209;
      border: 2px solid var(--marigold);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(248, 223, 1, 0.25);
    }
    .btn-save:hover {
      background: var(--marigold-hover);
    }

    /* ---- Media & Video Player Controls (Target: div:nth-of-type(1) > div:nth-of-type(4)) ---- */
    #media-card, div:nth-of-type(1) > div:nth-of-type(4) {
      margin-top: 2rem;
      border: 1px solid var(--line-strong);
      border-top: 3px solid var(--marigold);
      background: var(--surface);
      position: relative;
    }
    .media-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 1.75rem;
      margin-top: 1.25rem;
    }
    @media (max-width: 900px) {
      .media-grid { grid-template-columns: 1fr; }
    }
    .media-section-box {
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      padding: 1.25rem;
      border-radius: 4px;
    }
    .media-section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: .6rem;
      border-bottom: 1px solid var(--line-strong);
    }
    .media-section-title {
      font-family: 'Luckiest Guy', sans-serif;
      font-size: 1.2rem;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: .5rem;
    }
    .media-preview-container {
      margin-top: 1rem;
      border: 1px solid var(--line-strong);
      background: #000;
      border-radius: 4px;
      overflow: hidden;
      position: relative;
    }
    .media-preview-ratio-16-9 {
      aspect-ratio: 16/9;
      width: 100%;
    }
    .media-preview-ratio-9-16 {
      aspect-ratio: 9/16;
      max-width: 220px;
      margin: 0 auto;
    }
    .media-preview-container iframe,
    .media-preview-container img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border: 0;
    }
    .media-preset-pills {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      margin-top: .6rem;
    }
    .media-preset-btn {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      padding: .3rem .65rem;
      background: var(--surface);
      border: 1px solid var(--line-strong);
      color: var(--marigold);
      cursor: pointer;
      border-radius: 3px;
      transition: all .2s ease;
    }
    .media-preset-btn:hover {
      background: var(--marigold);
      color: #241209;
      border-color: var(--marigold);
    }
    .media-badge-live {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .7rem;
      color: #92e6a3;
      background: rgba(146, 230, 163, .12);
      border: 1px solid rgba(146, 230, 163, .3);
      padding: .2rem .55rem;
      border-radius: 999px;
      text-transform: uppercase;
      font-weight: 600;
    }
    .media-badge-live::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      background: #92e6a3;
      border-radius: 50%;
      animation: pulse-live 1.8s infinite;
    }
    @keyframes pulse-live {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: .4; transform: scale(.75); }
      100% { opacity: 1; transform: scale(1); }
    }

    /* ---- Poster Upload & Reviews Editor within Unified Media Panel ---- */
    .poster-input-flex {
      display: flex;
      gap: .5rem;
      align-items: center;
    }
    .poster-input-flex input {
      flex: 1;
    }
    .btn-upload-poster {
      background: var(--surface);
      border: 1px solid var(--line-strong);
      color: var(--marigold);
      padding: .65rem .85rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      white-space: nowrap;
      transition: all .2s ease;
      border-radius: 3px;
    }
    .btn-upload-poster:hover {
      background: var(--marigold);
      color: #241209;
      border-color: var(--marigold);
    }
    .btn-clear-poster {
      background: transparent;
      border: 1px solid rgba(215, 0, 0, .3);
      color: var(--burgundy);
      padding: .65rem .75rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: .75rem;
      cursor: pointer;
      white-space: nowrap;
      border-radius: 3px;
      transition: all .2s ease;
    }
    .btn-clear-poster:hover {
      background: rgba(215, 0, 0, .15);
      border-color: var(--burgundy);
    }

    .media-section-full {
      margin-top: 1.75rem;
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      padding: 1.4rem;
      border-radius: 4px;
    }
    .reviews-editor-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 1.25rem;
    }
    .review-card-edit {
      background: var(--surface);
      border: 1px solid var(--line-strong);
      padding: 1.2rem;
      border-radius: 4px;
      position: relative;
    }
    .review-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: .6rem;
      border-bottom: 1px dashed var(--line-strong);
      flex-wrap: wrap;
      gap: .5rem;
    }
    .review-card-title {
      display: flex;
      align-items: center;
      gap: .5rem;
      font-family: 'Luckiest Guy', sans-serif;
      font-size: 1.1rem;
      color: var(--marigold);
    }
    .review-layout-grid {
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 1.25rem;
    }
    @media (max-width: 950px) {
      .review-layout-grid {
        grid-template-columns: 1fr;
      }
    }
    .review-preview-thumb {
      aspect-ratio: 9/16;
      max-height: 280px;
      background: #000;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .review-preview-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .btn-add-review {
      font-family: 'IBM Plex Mono', monospace;
      font-size: .8rem;
      font-weight: 600;
      background: var(--surface);
      color: var(--marigold);
      border: 1px dashed var(--marigold);
      padding: .75rem 1.25rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      border-radius: 3px;
      transition: all .2s ease;
      margin-top: 1rem;
    }
    .btn-add-review:hover {
      background: rgba(232, 163, 61, .15);
      border-style: solid;
    }
    .btn-delete-review {
      background: transparent;
      border: 1px solid rgba(215, 0, 0, .3);
      color: var(--burgundy);
      font-family: 'IBM Plex Mono', monospace;
      font-size: .72rem;
      padding: .3rem .6rem;
      cursor: pointer;
      border-radius: 3px;
      transition: all .2s ease;
    }
    .btn-delete-review:hover {
      background: rgba(215, 0, 0, .15);
      border-color: var(--burgundy);
    }

    @media (max-width: 760px) {
      .form-row { grid-template-columns: 1fr; }
      .image-upload-wrap { grid-template-columns: 1fr; }
      .preview-box { width: 100%; height: 160px; }
      .site-nav { padding: .8rem 1rem; }
      .wrap { padding: 0 .75rem; }
    }
  </style>
</head>
<body>
  <nav class="site-nav">
    <span class="nav-brand">
      <span style="display:inline-block; width:10px; height:10px; background:var(--marigold); border-radius:50%;"></span>
      Wendo 2.0 · CMS Manager
    </span>
    <div class="nav-links">
      <a href="/" target="_blank">View Public Site ↗</a>
      <a href="/install.php">System Info</a>
    </div>
  </nav>

  <div class="wrap">
    <% if (typeof error !== 'undefined' && error) { %>
      <aside class="alert-banner" id="alert-banner" style="border-color:#ff5252; color:#ff9999; background:rgba(255,82,82,.15);">
        <span>⚠ <%= error %></span>
        <button type="button" onclick="document.getElementById('alert-banner').remove()" style="background:none;border:none;color:#ff9999;font-size:1.2rem;cursor:pointer;">✕</button>
      </aside>
    <% } %>

    <% if (typeof media_saved !== 'undefined' && media_saved) { %>
      <aside class="alert-banner" id="alert-banner-media" style="border-color:#e8a33d; color:#ffd285; background:rgba(232,163,61,.15);">
        <span>✓ Media player settings updated successfully! The new trailer is now playing live on the front end.</span>
        <button type="button" onclick="document.getElementById('alert-banner-media').remove()" style="background:none;border:none;color:#ffd285;font-size:1.2rem;cursor:pointer;">✕</button>
      </aside>
    <% } %>

    <% if (saved) { %>
      <aside class="alert-banner" id="alert-banner">
        <span>✓ Product catalog updated successfully. Changes are live on the storefront!</span>
        <button type="button" onclick="document.getElementById('alert-banner').remove()" style="background:none;border:none;color:#92e6a3;font-size:1.2rem;cursor:pointer;">✕</button>
      </aside>
    <% } %>

    <% if (deleted) { %>
      <aside class="alert-banner" id="alert-banner" style="border-color:#ff5252; color:#ff9999; background:rgba(255,82,82,.15);">
        <span>✓ Product was permanently removed from catalog.</span>
        <button type="button" onclick="document.getElementById('alert-banner').remove()" style="background:none;border:none;color:#ff9999;font-size:1.2rem;cursor:pointer;">✕</button>
      </aside>
    <% } %>

    <!-- Products & Inventory Card (Target selector: div:nth-of-type(1) > div:nth-of-type(1)) -->
    <div class="card" id="products-card">
      <div class="card-header-bar">
        <div class="card-title-group">
          <h2>Products &amp; Inventory <span class="card-count-badge"><%= products.length %> items</span></h2>
          <p>Click any product row or click Edit to update items, upload product photos, and configure sizes for Pesapal checkout.</p>
        </div>
        <button type="button" class="btn-add-product" onclick="openAddModal()">
          <span>＋</span> Add New Product
        </button>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th style="width: 70px;">Photo</th>
              <th>Item &amp; Description</th>
              <th>Category</th>
              <th>Price (KES)</th>
              <th>Configured Sizes</th>
              <th>Status</th>
              <th style="text-align: right; width: 180px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(p) { %>
            <tr class="product-row" id="row-prod-<%= p.id %>" onclick="handleRowClick(event, <%= p.id %>)">
              <td>
                <img class="prod-thumb" src="<%= p.image_path || '/assets/merch-tee.jpg' %>" alt="<%= p.name %>" onerror="this.src='/assets/merch-tee.jpg'">
              </td>
              <td class="col-name">
                <strong><%= p.name %></strong>
                <div class="prod-desc-snippet"><%= p.description || 'No description provided' %></div>
              </td>
              <td class="mono" style="font-size: .8rem; color: var(--marigold);"><%= p.category %></td>
              <td class="mono" style="font-weight: 700; color: var(--text);"><%= formatPrice(p.price_kes) %></td>
              <td>
                <% if (p.sizes && p.sizes.trim()) { %>
                  <% p.sizes.split(',').forEach(function(s) { %>
                    <span class="size-pill"><%= s.trim() %></span>
                  <% }); %>
                <% } else { %>
                  <span class="size-pill" style="opacity:.6;">One Size</span>
                <% } %>
              </td>
              <td>
                <% if (p.is_available) { %>
                  <span class="badge badge-green">Buyable Now</span>
                <% } else { %>
                  <span class="badge badge-gray">Coming Soon</span>
                <% } %>
              </td>
              <td style="text-align: right;">
                <div class="actions-cluster" style="justify-content: flex-end;" onclick="event.stopPropagation()">
                  <button type="button" class="btn-action btn-edit" onclick="openEditModal(<%= p.id %>)">✎ Edit</button>
                  <form action="/admin/toggle-product" method="POST" style="display:inline;">
                    <input type="hidden" name="id" value="<%= p.id %>">
                    <button type="submit" class="btn-action btn-toggle" title="Toggle visibility on storefront">
                      <%= p.is_available ? 'Hide' : 'Show' %>
                    </button>
                  </form>
                  <form action="/admin/products/delete" method="POST" style="display:inline;" onsubmit="return confirm('Permanently delete <%= p.name %>?');">
                    <input type="hidden" name="id" value="<%= p.id %>">
                    <button type="submit" class="btn-action btn-delete" title="Delete product">🗑</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent Orders Card -->
    <div class="card">
      <h2 style="color: var(--marigold); margin-bottom: 1.2rem; font-size: 1.7rem;">Recent Store Orders (Pesapal)</h2>
      <% if (orders && orders.length > 0) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Order Ref</th>
                <th>Customer</th>
                <th>Purchased Item</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Status</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(function(o) { %>
              <tr>
                <td class="mono">#<%= o.order_id %></td>
                <td>
                  <strong><%= o.customer_name %></strong><br>
                  <span class="mono" style="font-size: .8rem; color: var(--muted);"><%= o.customer_phone %></span>
                </td>
                <td><%= o.product_name %> <span class="size-pill"><%= o.size %></span></td>
                <td class="mono"><%= o.quantity %></td>
                <td class="mono" style="font-weight: 700; color: var(--marigold);"><%= formatPrice(o.amount_kes) %></td>
                <td><span class="badge badge-green"><%= o.payment_status %></span></td>
                <td class="mono" style="font-size: .8rem;"><%= new Date(o.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p style="color: var(--muted); font-size: .95rem;">No orders placed yet. Orders purchased on the storefront will show up here live.</p>
      <% } %>
    </div>

    <!-- Unified Media, Videos & Reviews Control Center (Consolidated Single Panel) -->
    <div class="card" id="media-card">
      <div class="card-header-bar">
        <div class="card-title-group">
          <div style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;">
            <h2>Live Media, Video Players &amp; Reviews</h2>
            <span class="media-badge-live">Front-End Synchronized</span>
          </div>
          <p>One unified panel to manage all website video URLs and custom poster images across the storefront: Hero Video (16:9), Story Spotlight (9:16), and Customer Video Reviews.</p>
        </div>
        <div style="display: flex; gap: .75rem; align-items: center; flex-wrap: wrap;">
          <a href="/" target="_blank" class="btn-cancel" style="text-decoration:none; display:inline-flex; align-items:center; gap:.4rem;">
            Preview Front End ↗
          </a>
          <button type="submit" form="mediaForm" class="btn-save" id="btnSaveMediaTop">
            Save All Media Settings
          </button>
        </div>
      </div>

      <form id="mediaForm" action="/admin/media/save" method="POST" onsubmit="handleMediaFormSubmit(event)">
        <input type="hidden" name="reviews_json" id="reviews_json_input" value="">

        <div class="media-grid">
          <!-- 1. Hero Section Video -->
          <div class="media-section-box">
            <div class="media-section-head">
              <span class="media-section-title">
                <span>🎬</span> Hero Video Player (16:9)
              </span>
              <span class="mono" style="font-size: .75rem; color: var(--marigold);">Main Landing Header</span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="hero_url">Website / Video URL or YouTube ID <span style="color:var(--burgundy)">*</span></label>
              <input type="text" id="hero_url" name="hero_url" class="form-control" 
                value="<%= (typeof media !== 'undefined' && media && media.hero && media.hero.url) ? media.hero.url : 'https://www.youtube.com/watch?v=cCo4F36en7E' %>" 
                placeholder="https://www.youtube.com/watch?v=... or 11-char ID" 
                oninput="updateHeroPreview()" required>
              <span class="field-hint">Supports YouTube links (watch?v=), short links (youtu.be/), or direct 11-character video IDs.</span>
            </div>

            <!-- Custom Poster Image URL + Upload Button -->
            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="hero_poster">Custom Poster Image URL</label>
              <div class="poster-input-flex">
                <input type="text" id="hero_poster" name="hero_poster" class="form-control" 
                  value="<%= (typeof media !== 'undefined' && media && media.hero && media.hero.poster_url) ? media.hero.poster_url : '' %>" 
                  placeholder="https://... or click Upload Poster" oninput="updateHeroPreview()">
                <button type="button" class="btn-upload-poster" onclick="triggerPosterUpload('hero_poster', updateHeroPreview)">
                  📁 Upload Poster
                </button>
                <button type="button" class="btn-clear-poster" title="Reset to YouTube thumbnail" onclick="clearPoster('hero_poster', updateHeroPreview)">
                  ✕ Clear
                </button>
              </div>
              <span class="field-hint">Custom thumbnail image for the hero video frame before playback starts.</span>
            </div>

            <!-- Quick Presets -->
            <div style="margin-bottom: 1rem;">
              <span class="mono" style="font-size: .72rem; color: var(--muted); display: block; margin-bottom: .3rem;">QUICK HERO PRESETS:</span>
              <div class="media-preset-pills">
                <button type="button" class="media-preset-btn" onclick="applyHeroPreset('https://www.youtube.com/watch?v=cCo4F36en7E', 329, 'Wendo 2.0 announcement', 'Playing muted. Tap the speaker on the player to hear it, or watch on', 'https://img.youtube.com/vi/cCo4F36en7E/hqdefault.jpg')">
                  Wendo 2.0 Trailer (Default)
                </button>
                <button type="button" class="media-preset-btn" onclick="applyHeroPreset('https://www.youtube.com/watch?v=f3LodYambh8', 0, 'Wendo 2.0 First Look Reel', 'Live coverage from the collective.', 'https://img.youtube.com/vi/f3LodYambh8/hqdefault.jpg')">
                  Wendo Reel (Alt)
                </button>
              </div>
            </div>

            <div class="form-row" style="margin-bottom: 1rem;">
              <div class="form-group">
                <label for="hero_start">Start Timestamp (seconds)</label>
                <input type="number" id="hero_start" name="hero_start" class="form-control" 
                  value="<%= (typeof media !== 'undefined' && media && media.hero && media.hero.start_seconds !== undefined) ? media.hero.start_seconds : 329 %>" 
                  min="0" placeholder="e.g. 329" oninput="updateHeroPreview()">
                <span class="field-hint">Timestamp when video begins playback (e.g. 329 = 5m 29s).</span>
              </div>
              <div class="form-group">
                <label for="hero_title">Player Title / Accessible Label</label>
                <input type="text" id="hero_title" name="hero_title" class="form-control" 
                  value="<%= (typeof media !== 'undefined' && media && media.hero && media.hero.title) ? media.hero.title : 'Wendo 2.0 announcement' %>" 
                  placeholder="e.g. Wendo 2.0 announcement">
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="hero_caption">Video Caption / Footnote Text</label>
              <input type="text" id="hero_caption" name="hero_caption" class="form-control" 
                value="<%= (typeof media !== 'undefined' && media && media.hero && media.hero.caption) ? media.hero.caption : 'Playing muted. Tap the speaker on the player to hear it, or watch on' %>" 
                placeholder="Text displayed below hero video frame">
            </div>

            <!-- Hero Live Preview Box -->
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.4rem;">
                <span class="mono" style="font-size: .75rem; color: var(--marigold); font-weight: 600;">HERO PLAYER LIVE PREVIEW:</span>
                <span id="heroIdBadge" class="mono" style="font-size: .72rem; color: var(--muted);">ID: cCo4F36en7E</span>
              </div>
              <div class="media-preview-container media-preview-ratio-16-9" id="heroPreviewBox">
                <!-- Dynamically populated by JS -->
              </div>
            </div>
          </div>

          <!-- 2. Story / Shorts Spotlight Video -->
          <div class="media-section-box">
            <div class="media-section-head">
              <span class="media-section-title">
                <span>📱</span> Story / Shorts Spotlight (9:16)
              </span>
              <span class="mono" style="font-size: .75rem; color: var(--marigold);">Ambũi Section</span>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="short_url">Website / Shorts URL or Video ID <span style="color:var(--burgundy)">*</span></label>
              <input type="text" id="short_url" name="short_url" class="form-control" 
                value="<%= (typeof media !== 'undefined' && media && media.short && media.short.url) ? media.short.url : 'https://www.youtube.com/shorts/f3LodYambh8' %>" 
                placeholder="https://www.youtube.com/shorts/... or 11-char ID" 
                oninput="updateShortPreview()" required>
              <span class="field-hint">Vertical format (9:16) for highlights and artist spotlights.</span>
            </div>

            <!-- Custom Poster Image URL + Upload Button -->
            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="short_poster">Custom Poster Image URL</label>
              <div class="poster-input-flex">
                <input type="text" id="short_poster" name="short_poster" class="form-control" 
                  value="<%= (typeof media !== 'undefined' && media && media.short && media.short.poster_url) ? media.short.poster_url : '' %>" 
                  placeholder="https://... or click Upload Poster" oninput="updateShortPreview()">
                <button type="button" class="btn-upload-poster" onclick="triggerPosterUpload('short_poster', updateShortPreview)">
                  📁 Upload Poster
                </button>
                <button type="button" class="btn-clear-poster" title="Reset to YouTube thumbnail" onclick="clearPoster('short_poster', updateShortPreview)">
                  ✕ Clear
                </button>
              </div>
              <span class="field-hint">Custom thumbnail image for the vertical short before playback starts.</span>
            </div>

            <!-- Quick Presets -->
            <div style="margin-bottom: 1rem;">
              <span class="mono" style="font-size: .72rem; color: var(--muted); display: block; margin-bottom: .3rem;">QUICK SHORTS PRESETS:</span>
              <div class="media-preset-pills">
                <button type="button" class="media-preset-btn" onclick="applyShortPreset('https://www.youtube.com/shorts/f3LodYambh8', 'Wendo 2.0 short', 'First look, also on', 'https://img.youtube.com/vi/f3LodYambh8/hqdefault.jpg')">
                  Wendo 2.0 Short (Default)
                </button>
                <button type="button" class="media-preset-btn" onclick="applyShortPreset('https://www.youtube.com/watch?v=cCo4F36en7E', 'Wendo Collective Story', 'Experience the sound, also on', 'https://img.youtube.com/vi/cCo4F36en7E/hqdefault.jpg')">
                  Trailer Teaser (Alt)
                </button>
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="short_title">Short Title</label>
              <input type="text" id="short_title" name="short_title" class="form-control" 
                value="<%= (typeof media !== 'undefined' && media && media.short && media.short.title) ? media.short.title : 'Wendo 2.0 short' %>" 
                placeholder="e.g. Wendo 2.0 short">
            </div>

            <div class="form-group" style="margin-bottom: 1rem;">
              <label for="short_caption">Short Caption</label>
              <input type="text" id="short_caption" name="short_caption" class="form-control" 
                value="<%= (typeof media !== 'undefined' && media && media.short && media.short.caption) ? media.short.caption : 'First look, also on' %>" 
                placeholder="e.g. First look, also on">
            </div>

            <!-- Shorts Live Preview Box -->
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.4rem;">
                <span class="mono" style="font-size: .75rem; color: var(--marigold); font-weight: 600;">SHORTS LIVE PREVIEW:</span>
                <span id="shortIdBadge" class="mono" style="font-size: .72rem; color: var(--muted);">ID: f3LodYambh8</span>
              </div>
              <div class="media-preview-container media-preview-ratio-9-16" id="shortPreviewBox">
                <!-- Dynamically populated by JS -->
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Customer Video Reviews & Testimonials Section -->
        <div class="media-section-full">
          <div class="media-section-head">
            <div>
              <span class="media-section-title">
                <span>⭐</span> Customer Video Reviews &amp; Testimonials
              </span>
              <p style="margin: .3rem 0 0; font-size: .85rem; color: var(--muted);">
                Input website video URLs, custom poster images, and quotes for each review in the "From The Crowd" section.
              </p>
            </div>
            <button type="button" class="btn-add-review" onclick="addNewReviewItem()">
              + Add Video Review
            </button>
          </div>

          <div id="reviewsEditorContainer" class="reviews-editor-grid">
            <!-- Dynamically populated by renderReviewsEditor() -->
          </div>
        </div>

        <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line-strong); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
          <div id="mediaStatusMsg" class="mono" style="font-size: .85rem; color: var(--muted);">
            Changes to video URLs and custom poster images update the front-end landing page immediately upon saving.
          </div>
          <button type="submit" class="btn-save" id="btnSaveMediaBottom">
            Save All Media Settings
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- PRODUCT EDIT / ADD MODAL -->
  <div class="modal-backdrop" id="productModal" onclick="handleBackdropClick(event)">
    <div class="modal-card">
      <div class="modal-head">
        <div>
          <h3 id="modalTitle">Edit Product</h3>
          <p class="modal-subtitle">Configure product pricing, arrange photos (1st is main cover), and select checkout sizes.</p>
        </div>
        <button type="button" class="btn-close" onclick="closeModal()" title="Close (Esc)">✕</button>
      </div>

      <form id="productForm" action="/admin/products/save" method="POST" enctype="multipart/form-data" onsubmit="return handleFormSubmit(event)">
        <input type="hidden" name="id" id="modal_id" value="">
        <input type="hidden" name="existing_images" id="modal_existing_images" value="[]">

        <!-- Essential Details: Name & Price -->
        <div class="form-row">
          <div class="form-group">
            <label for="modal_name">Product Name *</label>
            <input type="text" class="form-control" name="name" id="modal_name" placeholder="e.g. Ambũi Embroidered Cap" required>
          </div>
          <div class="form-group">
            <label for="modal_price">Price in KES *</label>
            <input type="number" class="form-control mono" name="price_kes" id="modal_price" placeholder="2500" min="0" step="50" required>
          </div>
        </div>

        <!-- Category & Availability -->
        <div class="form-row">
          <div class="form-group">
            <label for="modal_category">Category *</label>
            <input type="text" class="form-control" name="category" id="modal_category" placeholder="Drop 01 · Apparel" required>
            <div class="cat-presets">
              <button type="button" class="btn-cat-preset" onclick="setCategory('Drop 01 · Apparel')">Apparel</button>
              <button type="button" class="btn-cat-preset" onclick="setCategory('Drop 01 · Keepsake')">Keepsake</button>
              <button type="button" class="btn-cat-preset" onclick="setCategory('Drop 01 · Accessories')">Accessories</button>
              <button type="button" class="btn-cat-preset" onclick="setCategory('Limited Edition')">Limited</button>
            </div>
          </div>
          <div class="form-group">
            <label>Storefront Status</label>
            <div class="avail-box" id="availToggleBox" onclick="toggleStoreAvailability()">
              <input type="checkbox" name="is_available" id="modal_is_available" value="1" style="display:none;">
              <span id="availIndicator" style="display:inline-block;width:12px;height:12px;border-radius:50%;background:#22c55e;"></span>
              <div>
                <strong id="availTitle" style="display:block;font-size:.85rem;color:var(--text);">Buyable Immediately</strong>
                <span id="availSubtitle" style="font-size:.72rem;color:var(--muted);">Displayed with live Pesapal checkout</span>
              </div>
            </div>
          </div>
        </div>

        <!-- PRODUCT IMAGES (ARRANGE 1ST AS MAIN COVER & DELETE) -->
        <div class="form-group">
          <label style="display:flex; justify-content:space-between; align-items:center;">
            <span>Product Photos &amp; Cover Selection</span>
            <span id="photoCountNotice" style="font-size:.72rem; color:var(--muted); font-weight:normal; text-transform:none;"></span>
          </label>

          <div class="gallery-manager-box" id="galleryDropZone" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)">
            <div class="gallery-notice">
              <span style="color:var(--marigold); font-size:1.1rem; line-height:1;">★</span>
              <div>
                <strong>Main Image Rule:</strong> The photo arranged <strong>first (1st)</strong> is your product’s primary cover on the storefront &amp; Pesapal checkout. Click <strong>"★ Make Main"</strong> or use <strong>◀</strong> to arrange any photo first. Click <strong>✕</strong> to delete photos.
              </div>
            </div>

            <!-- Dynamic Image Grid -->
            <div class="gallery-grid" id="productImageGallery">
              <!-- Dynamically populated via renderImageGallery() -->
            </div>

            <!-- Add / Upload Toolbar -->
            <div class="toolbar-buttons">
              <input type="file" id="modal_file_upload" accept="image/*" multiple style="display:none;" onchange="handleFileUpload(event)">
              <button type="button" class="btn-tool btn-tool-upload" onclick="document.getElementById('modal_file_upload').click()">
                <span>＋</span> Upload Photo(s)
              </button>
              <button type="button" class="btn-tool btn-tool-gallery" onclick="togglePresetsTray()">
                <span>🖼</span> Add from Festival Gallery
              </button>
              <span id="uploadStatusText" class="upload-status-indicator"></span>
            </div>

            <!-- Festival Gallery Presets Tray -->
            <div class="asset-presets-tray" id="presetsTray" style="display:none;">
              <span style="width:100%;font-family:monospace;font-size:.7rem;color:var(--muted);margin-bottom:.2rem;">
                Click any asset to attach it to this product:
              </span>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/merch-tee.jpg', 'Ambũi Tee')">
                <img src="/assets/merch-tee.jpg" alt="Tee">
                <span>Ambũi Tee</span>
              </button>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/merch-hoodie.jpg', 'Heritage Hoodie')">
                <img src="/assets/merch-hoodie.jpg" alt="Hoodie">
                <span>Heritage Hoodie</span>
              </button>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/merch-wristband.jpg', '2.0 Wristband')">
                <img src="/assets/merch-wristband.jpg" alt="Wristband">
                <span>2.0 Wristband</span>
              </button>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/moment-2.jpg', 'Fashion Coat')">
                <img src="/assets/moment-2.jpg" alt="Coat">
                <span>Fashion Coat</span>
              </button>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/moment-1.jpg', 'Festival Crowd')">
                <img src="/assets/moment-1.jpg" alt="Crowd">
                <span>Festival Crowd</span>
              </button>
              <button type="button" class="preset-pill-card" onclick="addPresetImage('/assets/moment-4-stage.jpg', 'Stage Night')">
                <img src="/assets/moment-4-stage.jpg" alt="Stage">
                <span>Stage Night</span>
              </button>
            </div>
          </div>
        </div>

        <!-- SIZES PICKER -->
        <div class="form-group">
          <label>Pick Available Sizes</label>
          <div class="size-picker-box">
            <div class="size-presets">
              <span style="font-family:monospace;font-size:.7rem;color:var(--muted);margin-right:.4rem;">Quick Presets:</span>
              <button type="button" class="btn-preset" onclick="applyPresetSizes(['S', 'M', 'L', 'XL', 'XXL'])">Apparel (S-XXL)</button>
              <button type="button" class="btn-preset" onclick="applyPresetSizes(['M', 'L', 'XL'])">Standard (M-XL)</button>
              <button type="button" class="btn-preset" onclick="applyPresetSizes(['XS', 'S', 'M', 'L', 'XL', '2XL', '3XL'])">Extended (XS-3XL)</button>
              <button type="button" class="btn-preset" onclick="applyPresetSizes(['One Size'])">One Size</button>
              <button type="button" class="btn-preset" onclick="applyPresetSizes([])">Clear All</button>
            </div>

            <div class="size-chips-grid" id="sizeChipsContainer">
              <div class="chip-size" data-size="XS" onclick="toggleSize('XS')">XS</div>
              <div class="chip-size" data-size="S" onclick="toggleSize('S')">S</div>
              <div class="chip-size" data-size="M" onclick="toggleSize('M')">M</div>
              <div class="chip-size" data-size="L" onclick="toggleSize('L')">L</div>
              <div class="chip-size" data-size="XL" onclick="toggleSize('XL')">XL</div>
              <div class="chip-size" data-size="XXL" onclick="toggleSize('XXL')">XXL</div>
              <div class="chip-size" data-size="2XL" onclick="toggleSize('2XL')">2XL</div>
              <div class="chip-size" data-size="3XL" onclick="toggleSize('3XL')">3XL</div>
              <div class="chip-size" data-size="One Size" onclick="toggleSize('One Size')">One Size</div>
            </div>

            <input type="text" class="form-control mono" name="sizes" id="modal_sizes" placeholder="e.g. S, M, L, XL, XXL" oninput="syncChipsFromInput()">
          </div>
          <p class="hint">Customers will select from these sizes during the Pesapal order checkout.</p>
        </div>

        <!-- Description -->
        <div class="form-group">
          <label for="modal_description">Description / Craft Specifications</label>
          <textarea class="form-control" name="description" id="modal_description" rows="2" placeholder="Fabric composition, weight, print details..."></textarea>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-cancel" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn-save" id="btnSaveModal">Save Product</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Inlined product database for instant interactive modal opening
    const productsData = <%- JSON.stringify(products) %>;
    const initialEditId = '<%= editId %>';

    let currentSelectedSizes = [];
    let currentImages = [];

    function handleRowClick(event, prodId) {
      openEditModal(prodId);
    }

    function setCategory(cat) {
      document.getElementById('modal_category').value = cat;
    }

    function toggleStoreAvailability(forcedVal) {
      const chk = document.getElementById('modal_is_available');
      const box = document.getElementById('availToggleBox');
      const dot = document.getElementById('availIndicator');
      const title = document.getElementById('availTitle');
      const subtitle = document.getElementById('availSubtitle');

      if (typeof forcedVal === 'boolean') {
        chk.checked = forcedVal;
      } else {
        chk.checked = !chk.checked;
      }

      if (chk.checked) {
        box.classList.add('active');
        dot.style.background = '#22c55e';
        title.textContent = 'Buyable Immediately';
        title.style.color = '#92e6a3';
        subtitle.textContent = 'Active on storefront with Pesapal checkout';
      } else {
        box.classList.remove('active');
        dot.style.background = '#888888';
        title.textContent = 'Marked as Coming Soon';
        title.style.color = 'var(--muted)';
        subtitle.textContent = 'Preview only on storefront (checkout disabled)';
      }
    }

    function togglePresetsTray() {
      const tray = document.getElementById('presetsTray');
      tray.style.display = (tray.style.display === 'none' || !tray.style.display) ? 'flex' : 'none';
    }

    // GALLERY IMAGE MANAGEMENT (ARRANGE 1ST AS MAIN, REORDER, DELETE)
    function renderImageGallery() {
      const container = document.getElementById('productImageGallery');
      const countNotice = document.getElementById('photoCountNotice');
      container.innerHTML = '';

      if (currentImages.length === 0) {
        currentImages = ['/assets/merch-tee.jpg'];
      }

      countNotice.textContent = `${currentImages.length} photo${currentImages.length === 1 ? '' : 's'} attached`;

      currentImages.forEach((imgUrl, index) => {
        const isMain = (index === 0);
        const card = document.createElement('div');
        card.className = 'gallery-card' + (isMain ? ' is-main' : '');

        // Top Badge
        const badge = document.createElement('span');
        if (isMain) {
          badge.className = 'badge-main-cover';
          badge.textContent = '★ 1st · Main Cover';
          badge.title = 'Arranged 1st: This is the product cover image shown on the storefront and checkout';
        } else {
          badge.className = 'badge-pos';
          badge.textContent = `Photo #${index + 1}`;
        }
        card.appendChild(badge);

        // Thumbnail
        const thumbWrap = document.createElement('div');
        thumbWrap.className = 'gallery-img-wrap';
        const img = document.createElement('img');
        img.src = imgUrl;
        img.alt = `Product photo ${index + 1}`;
        img.onerror = () => { img.src = '/assets/merch-tee.jpg'; };
        thumbWrap.appendChild(img);
        card.appendChild(thumbWrap);

        // Action Toolbar
        const actions = document.createElement('div');
        actions.className = 'gallery-actions';

        if (!isMain) {
          // Make Main button
          const btnMain = document.createElement('button');
          btnMain.type = 'button';
          btnMain.className = 'btn-set-main';
          btnMain.innerHTML = '★ Make Main';
          btnMain.title = 'Move this photo to the 1st position as the primary cover';
          btnMain.onclick = (e) => { e.stopPropagation(); makeImageMain(index); };
          actions.appendChild(btnMain);
        } else {
          const mainTag = document.createElement('span');
          mainTag.style.fontSize = '.62rem';
          mainTag.style.color = 'var(--marigold)';
          mainTag.style.fontFamily = 'monospace';
          mainTag.style.fontWeight = 'bold';
          mainTag.style.paddingLeft = '.2rem';
          mainTag.textContent = '✓ Active Cover';
          actions.appendChild(mainTag);
        }

        // Left Arrow
        const btnLeft = document.createElement('button');
        btnLeft.type = 'button';
        btnLeft.className = 'btn-order-arrow';
        btnLeft.innerHTML = '◀';
        btnLeft.title = 'Move earlier';
        btnLeft.disabled = (index === 0);
        btnLeft.onclick = (e) => { e.stopPropagation(); moveImage(index, -1); };
        actions.appendChild(btnLeft);

        // Right Arrow
        const btnRight = document.createElement('button');
        btnRight.type = 'button';
        btnRight.className = 'btn-order-arrow';
        btnRight.innerHTML = '▶';
        btnRight.title = 'Move later';
        btnRight.disabled = (index === currentImages.length - 1);
        btnRight.onclick = (e) => { e.stopPropagation(); moveImage(index, 1); };
        actions.appendChild(btnRight);

        // Delete Button
        const btnDel = document.createElement('button');
        btnDel.type = 'button';
        btnDel.className = 'btn-del-img';
        btnDel.innerHTML = '✕';
        btnDel.title = 'Delete photo from product';
        btnDel.onclick = (e) => { e.stopPropagation(); deleteImage(index); };
        actions.appendChild(btnDel);

        card.appendChild(actions);
        container.appendChild(card);
      });

      // Update hidden form field
      document.getElementById('modal_existing_images').value = JSON.stringify(currentImages);
    }

    function makeImageMain(index) {
      if (index <= 0 || index >= currentImages.length) return;
      const [chosen] = currentImages.splice(index, 1);
      currentImages.unshift(chosen);
      renderImageGallery();
    }

    function moveImage(index, delta) {
      const target = index + delta;
      if (target < 0 || target >= currentImages.length) return;
      const temp = currentImages[index];
      currentImages[index] = currentImages[target];
      currentImages[target] = temp;
      renderImageGallery();
    }

    function deleteImage(index) {
      if (index < 0 || index >= currentImages.length) return;
      currentImages.splice(index, 1);
      if (currentImages.length === 0) {
        currentImages = ['/assets/merch-tee.jpg'];
      }
      renderImageGallery();
    }

    function addPresetImage(assetPath) {
      if (!currentImages.includes(assetPath)) {
        currentImages.push(assetPath);
      }
      renderImageGallery();
    }

    function fileToDataUrl(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => resolve(e.target.result);
        reader.onerror = () => resolve('/assets/merch-tee.jpg');
        reader.readAsDataURL(file);
      });
    }

    function handleDragOver(e) {
      e.preventDefault();
      e.stopPropagation();
      const dropZone = document.getElementById('galleryDropZone');
      if (dropZone) dropZone.classList.add('drag-active');
    }

    function handleDragLeave(e) {
      e.preventDefault();
      e.stopPropagation();
      const dropZone = document.getElementById('galleryDropZone');
      if (dropZone) dropZone.classList.remove('drag-active');
    }

    function handleDrop(e) {
      e.preventDefault();
      e.stopPropagation();
      const dropZone = document.getElementById('galleryDropZone');
      if (dropZone) dropZone.classList.remove('drag-active');
      const dt = e.dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFileUpload({ target: { files: dt.files, value: '' } });
      }
    }

    let isUploading = false;

    async function handleFileUpload(event) {
      const files = event.target ? event.target.files : event.files;
      if (!files || files.length === 0) return;

      const status = document.getElementById('uploadStatusText');
      const saveBtn = document.getElementById('btnSaveModal');
      const originalSaveText = saveBtn ? saveBtn.textContent : 'Save Product';

      isUploading = true;
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Uploading photos...';
      }
      if (status) status.textContent = `Uploading ${files.length} photo(s)...`;

      const uploadList = Array.from(files);

      for (let i = 0; i < uploadList.length; i++) {
        const file = uploadList[i];
        try {
          const fd = new FormData();
          fd.append('file', file);

          const res = await fetch('/admin/api/upload-image', {
            method: 'POST',
            body: fd
          });

          let savedUrl = null;
          const contentType = res.headers.get('content-type') || '';

          if (res.ok && contentType.includes('application/json')) {
            const data = await res.json();
            if (data && data.success && data.url) {
              savedUrl = data.url;
            }
          }

          // If upload endpoint didn't return a JSON URL, fallback to DataURL
          if (!savedUrl) {
            savedUrl = await fileToDataUrl(file);
          }

          if (savedUrl && !currentImages.includes(savedUrl)) {
            currentImages.push(savedUrl);
          }
        } catch (err) {
          console.warn('Async upload fallback to local preview:', err.message);
          try {
            const fallbackUrl = await fileToDataUrl(file);
            if (fallbackUrl && !currentImages.includes(fallbackUrl)) {
              currentImages.push(fallbackUrl);
            }
          } catch (e) {
            console.error('File reading failed:', e);
          }
        }
      }

      isUploading = false;
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = originalSaveText;
      }
      if (status) {
        status.textContent = '✓ Photo(s) ready!';
        setTimeout(() => { status.textContent = ''; }, 3000);
      }
      if (event.target) event.target.value = '';
      renderImageGallery();
    }

    function handleFormSubmit(e) {
      if (isUploading) {
        e.preventDefault();
        alert('Please wait for photos to finish uploading before saving.');
        return false;
      }
      // Guarantee synchronized hidden input
      document.getElementById('modal_existing_images').value = JSON.stringify(currentImages);
      const saveBtn = document.getElementById('btnSaveModal');
      if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
      }
      return true;
    }

    function openAddModal() {
      document.getElementById('modalTitle').textContent = '＋ Add New Product';
      document.getElementById('modal_id').value = '';
      document.getElementById('modal_name').value = '';
      document.getElementById('modal_category').value = 'Drop 01 · Apparel';
      document.getElementById('modal_price').value = '2500';
      document.getElementById('modal_description').value = '';
      document.getElementById('btnSaveModal').textContent = 'Create Product';

      toggleStoreAvailability(true);

      currentImages = ['/assets/merch-tee.jpg'];
      renderImageGallery();

      applyPresetSizes(['S', 'M', 'L', 'XL', 'XXL']);
      document.getElementById('productModal').classList.add('open');
      document.getElementById('modal_name').focus();
    }

    function openEditModal(prodId) {
      const prod = productsData.find(p => p.id === Number(prodId));
      if (!prod) return;

      document.getElementById('modalTitle').textContent = '✎ Edit: ' + prod.name;
      document.getElementById('modal_id').value = prod.id;
      document.getElementById('modal_name').value = prod.name || '';
      document.getElementById('modal_category').value = prod.category || '';
      document.getElementById('modal_price').value = prod.price_kes || 0;
      document.getElementById('modal_description').value = prod.description || '';
      document.getElementById('btnSaveModal').textContent = 'Update Product';

      toggleStoreAvailability(Boolean(prod.is_available));

      // Populate images array
      if (Array.isArray(prod.images) && prod.images.length > 0) {
        currentImages = [...prod.images];
      } else if (prod.image_path) {
        currentImages = [prod.image_path];
      } else {
        currentImages = ['/assets/merch-tee.jpg'];
      }
      renderImageGallery();

      // Parse sizes
      const sizesArray = (prod.sizes || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);
      applyPresetSizes(sizesArray);

      document.getElementById('productModal').classList.add('open');
      document.getElementById('modal_name').focus();
    }

    function closeModal() {
      document.getElementById('productModal').classList.remove('open');
      const tray = document.getElementById('presetsTray');
      if (tray) tray.style.display = 'none';
    }

    function handleBackdropClick(event) {
      if (event.target.id === 'productModal') {
        closeModal();
      }
    }

    // Size Picker logic
    function toggleSize(size) {
      const idx = currentSelectedSizes.indexOf(size);
      if (idx > -1) {
        currentSelectedSizes.splice(idx, 1);
      } else {
        currentSelectedSizes.push(size);
      }
      syncSizesUI();
    }

    function applyPresetSizes(sizesArray) {
      currentSelectedSizes = [...sizesArray];
      syncSizesUI();
    }

    function syncSizesUI() {
      const chips = document.querySelectorAll('#sizeChipsContainer .chip-size');
      chips.forEach(chip => {
        const size = chip.getAttribute('data-size');
        if (currentSelectedSizes.includes(size)) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });
      document.getElementById('modal_sizes').value = currentSelectedSizes.join(', ');
    }

    function syncChipsFromInput() {
      const val = document.getElementById('modal_sizes').value;
      currentSelectedSizes = val
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);
      const chips = document.querySelectorAll('#sizeChipsContainer .chip-size');
      chips.forEach(chip => {
        const size = chip.getAttribute('data-size');
        if (currentSelectedSizes.includes(size)) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });
    }

    // ---- Media Player & Reviews Live Management ----
    let reviewsList = <%- JSON.stringify(reviews || []) %>;

    function parseYouTubeId(input) {
      if (!input) return '';
      const str = input.trim();
      if (/^[a-zA-Z0-9_-]{11}$/.test(str)) {
        return str;
      }
      const match = str.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/|watch\?.+&v=))([\w-]{11})/);
      return match ? match[1] : '';
    }

    function parseYouTubeStartTime(url) {
      if (!url) return 0;
      const m = url.match(/[?&]t=(\d+)/);
      return m ? parseInt(m[1], 10) : 0;
    }

    function triggerPosterUpload(targetInputId, callback) {
      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/*';
      fileInput.style.display = 'none';
      document.body.appendChild(fileInput);

      fileInput.onchange = async () => {
        if (!fileInput.files || fileInput.files.length === 0) {
          fileInput.remove();
          return;
        }
        const file = fileInput.files[0];
        const formData = new FormData();
        formData.append('image', file);

        try {
          const res = await fetch('/admin/api/upload-image', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success && data.imageUrl) {
            const input = document.getElementById(targetInputId);
            if (input) {
              input.value = data.imageUrl;
              input.dispatchEvent(new Event('input'));
            }
            if (typeof callback === 'function') callback();
          } else {
            alert('Upload failed: ' + (data.error || 'Server error'));
          }
        } catch (e) {
          alert('Upload failed: ' + e.message);
        } finally {
          fileInput.remove();
        }
      };

      fileInput.click();
    }

    function clearPoster(targetInputId, callback) {
      const input = document.getElementById(targetInputId);
      if (input) {
        input.value = '';
        input.dispatchEvent(new Event('input'));
      }
      if (typeof callback === 'function') callback();
    }

    function applyHeroPreset(url, start, title, caption, poster) {
      document.getElementById('hero_url').value = url;
      document.getElementById('hero_start').value = start;
      if (title) document.getElementById('hero_title').value = title;
      if (caption) document.getElementById('hero_caption').value = caption;
      if (poster) document.getElementById('hero_poster').value = poster;
      updateHeroPreview();
    }

    function applyShortPreset(url, title, caption, poster) {
      document.getElementById('short_url').value = url;
      if (title) document.getElementById('short_title').value = title;
      if (caption) document.getElementById('short_caption').value = caption;
      if (poster) document.getElementById('short_poster').value = poster;
      updateShortPreview();
    }

    function updateHeroPreview() {
      const url = document.getElementById('hero_url').value;
      const start = document.getElementById('hero_start').value;
      const customPoster = document.getElementById('hero_poster').value.trim();
      const videoId = parseYouTubeId(url) || 'cCo4F36en7E';
      const badge = document.getElementById('heroIdBadge');
      if (badge) badge.textContent = 'ID: ' + videoId;

      const previewBox = document.getElementById('heroPreviewBox');
      if (!previewBox) return;

      const posterUrl = customPoster || (videoId ? ('https://img.youtube.com/vi/' + videoId + '/hqdefault.jpg') : '');
      previewBox.innerHTML = `
        <img src="${posterUrl}" alt="Hero preview" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='https://img.youtube.com/vi/${videoId}/hqdefault.jpg'">
        <div style="position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;">
          <a href="https://youtu.be/${videoId}${start ? '?t=' + start : ''}" target="_blank" style="padding:.6rem 1.2rem;background:var(--marigold);color:#241209;text-decoration:none;font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:.8rem;border-radius:3px;box-shadow:0 4px 10px rgba(0,0,0,.4);">
            ▶ Test on YouTube (${start ? start + 's' : '0s'})
          </a>
        </div>
      `;
    }

    function updateShortPreview() {
      const url = document.getElementById('short_url').value;
      const customPoster = document.getElementById('short_poster').value.trim();
      const videoId = parseYouTubeId(url) || 'f3LodYambh8';
      const badge = document.getElementById('shortIdBadge');
      if (badge) badge.textContent = 'ID: ' + videoId;

      const previewBox = document.getElementById('shortPreviewBox');
      if (!previewBox) return;

      const posterUrl = customPoster || (videoId ? ('https://img.youtube.com/vi/' + videoId + '/hqdefault.jpg') : '');
      previewBox.innerHTML = `
        <img src="${posterUrl}" alt="Short preview" style="width:100%;height:100%;object-fit:cover;" onerror="this.src='https://img.youtube.com/vi/${videoId}/hqdefault.jpg'">
        <div style="position:absolute;inset:0;background:rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;">
          <a href="https://www.youtube.com/shorts/${videoId}" target="_blank" style="padding:.5rem .9rem;background:var(--marigold);color:#241209;text-decoration:none;font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:.75rem;border-radius:3px;box-shadow:0 4px 10px rgba(0,0,0,.4);">
            ▶ Test Short
          </a>
        </div>
      `;
    }

    // ---- Review Items Management ----
    function renderReviewsEditor() {
      const container = document.getElementById('reviewsEditorContainer');
      if (!container) return;

      if (!reviewsList || reviewsList.length === 0) {
        container.innerHTML = `
          <div style="padding: 1.5rem; text-align: center; border: 1px dashed var(--line-strong); background: var(--surface);">
            <p style="color: var(--muted); margin: 0 0 .8rem; font-size: .9rem;">No video reviews added yet.</p>
            <button type="button" class="btn-add-review" onclick="addNewReviewItem()" style="margin: 0;">
              + Add First Video Review
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = reviewsList.map((rev, index) => {
        const vidId = parseYouTubeId(rev.video_url || '');
        const poster = rev.poster_url || (vidId ? `https://img.youtube.com/vi/${vidId}/hqdefault.jpg` : '');
        const isPub = (rev.is_published === 1 || rev.is_published === '1' || rev.is_published === true);

        return `
          <div class="review-card-edit" id="review-card-${index}">
            <div class="review-card-top">
              <div class="review-card-title">
                <span>💬 Review #${index + 1}: ${escapeHtml(rev.reviewer_name || 'Anonymous')}</span>
              </div>
              <div style="display:flex; align-items:center; gap: 1rem;">
                <label style="display:inline-flex; align-items:center; gap:.4rem; font-size:.8rem; font-family:'IBM Plex Mono',monospace; cursor:pointer; color: ${isPub ? '#92e6a3' : 'var(--muted)'};">
                  <input type="checkbox" ${isPub ? 'checked' : ''} onchange="updateReviewField(${index}, 'is_published', this.checked ? 1 : 0)">
                  <span>${isPub ? 'Published' : 'Draft / Hidden'}</span>
                </label>
                <button type="button" class="btn-delete-review" onclick="deleteReviewItem(${index})" title="Remove this review">
                  ✕ Remove
                </button>
              </div>
            </div>

            <div class="review-layout-grid">
              <div>
                <div class="form-row" style="margin-bottom: .85rem;">
                  <div class="form-group">
                    <label>Reviewer Name <span style="color:var(--burgundy)">*</span></label>
                    <input type="text" class="form-control" value="${escapeHtml(rev.reviewer_name || '')}" 
                      placeholder="e.g. Wanjiku M." oninput="updateReviewField(${index}, 'reviewer_name', this.value)">
                  </div>
                  <div class="form-group">
                    <label>Website / Video URL (YouTube or link) <span style="color:var(--burgundy)">*</span></label>
                    <input type="text" class="form-control" id="rev_url_${index}" value="${escapeHtml(rev.video_url || rev.video_path || '')}" 
                      placeholder="https://www.youtube.com/watch?v=..." oninput="updateReviewField(${index}, 'video_url', this.value)">
                  </div>
                </div>

                <div class="form-group" style="margin-bottom: .85rem;">
                  <label>Custom Poster Image URL</label>
                  <div class="poster-input-flex">
                    <input type="text" class="form-control" id="rev_poster_${index}" value="${escapeHtml(rev.poster_url || '')}" 
                      placeholder="https://... or click Upload Poster" oninput="updateReviewField(${index}, 'poster_url', this.value)">
                    <button type="button" class="btn-upload-poster" onclick="triggerPosterUpload('rev_poster_${index}', () => updateReviewField(${index}, 'poster_url', document.getElementById('rev_poster_${index}').value))">
                      📁 Upload Poster
                    </button>
                    <button type="button" class="btn-clear-poster" title="Reset poster" onclick="clearPoster('rev_poster_${index}', () => updateReviewField(${index}, 'poster_url', ''))">
                      ✕ Clear
                    </button>
                  </div>
                  <span class="field-hint">Upload or paste an image URL to replace the default video frame.</span>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                  <label>Review Caption / Quote</label>
                  <textarea class="form-control" rows="2" placeholder="“The vibe at 1.0 was unmatched...”" 
                    oninput="updateReviewField(${index}, 'caption', this.value)">${escapeHtml(rev.caption || '')}</textarea>
                </div>
              </div>

              <!-- Live Preview Column -->
              <div>
                <span class="mono" style="font-size: .72rem; color: var(--marigold); display: block; margin-bottom: .3rem; font-weight:600;">
                  THUMBNAIL PREVIEW:
                </span>
                <div class="review-preview-thumb" id="rev_preview_${index}">
                  ${poster ? `
                    <img src="${poster}" alt="Review thumbnail" onerror="this.style.display='none'">
                  ` : `
                    <span class="mono" style="font-size:.75rem; color:var(--muted); text-align:center; padding:.5rem;">No Poster / Video</span>
                  `}
                  ${rev.video_url ? `
                    <div style="position:absolute; inset:0; background:rgba(0,0,0,.35); display:flex; align-items:center; justify-content:center;">
                      <a href="${rev.video_url}" target="_blank" style="padding:.35rem .7rem; background:var(--marigold); color:#241209; text-decoration:none; font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:.7rem; border-radius:3px;">
                        ▶ Test Video
                      </a>
                    </div>
                  ` : ''}
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function updateReviewField(index, field, value) {
      if (!reviewsList[index]) return;
      reviewsList[index][field] = value;

      // Update thumbnail preview dynamically if URL or poster changed
      if (field === 'video_url' || field === 'poster_url') {
        const rev = reviewsList[index];
        const vidId = parseYouTubeId(rev.video_url || '');
        const poster = rev.poster_url || (vidId ? `https://img.youtube.com/vi/${vidId}/hqdefault.jpg` : '');
        const thumb = document.getElementById(`rev_preview_${index}`);
        if (thumb) {
          thumb.innerHTML = `
            ${poster ? `<img src="${poster}" alt="Review thumbnail" onerror="this.style.display='none'">` : `<span class="mono" style="font-size:.75rem; color:var(--muted); text-align:center; padding:.5rem;">No Poster / Video</span>`}
            ${rev.video_url ? `
              <div style="position:absolute; inset:0; background:rgba(0,0,0,.35); display:flex; align-items:center; justify-content:center;">
                <a href="${rev.video_url}" target="_blank" style="padding:.35rem .7rem; background:var(--marigold); color:#241209; text-decoration:none; font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:.7rem; border-radius:3px;">
                  ▶ Test Video
                </a>
              </div>
            ` : ''}
          `;
        }
      }
    }

    function addNewReviewItem() {
      const newId = Date.now();
      reviewsList.push({
        id: newId,
        reviewer_name: 'Guest Reviewer',
        caption: '“Can’t wait for Wendo 2.0!”',
        video_url: 'https://www.youtube.com/watch?v=cCo4F36en7E',
        poster_url: 'https://img.youtube.com/vi/cCo4F36en7E/hqdefault.jpg',
        video_path: '',
        is_published: 1,
        sort_order: reviewsList.length + 1
      });
      renderReviewsEditor();
    }

    function deleteReviewItem(index) {
      if (!confirm('Remove this video review from the storefront?')) return;
      reviewsList.splice(index, 1);
      renderReviewsEditor();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async function handleMediaFormSubmit(event) {
      event.preventDefault();
      const form = document.getElementById('mediaForm');
      const btnTop = document.getElementById('btnSaveMediaTop');
      const btnBottom = document.getElementById('btnSaveMediaBottom');
      const statusMsg = document.getElementById('mediaStatusMsg');

      if (btnTop) btnTop.textContent = 'Saving...';
      if (btnBottom) btnBottom.textContent = 'Saving...';
      if (statusMsg) {
        statusMsg.style.color = 'var(--marigold)';
        statusMsg.textContent = 'Saving website URLs and poster image settings...';
      }

      // Sync reviewsList into hidden input
      const reviewsJsonInput = document.getElementById('reviews_json_input');
      if (reviewsJsonInput) {
        reviewsJsonInput.value = JSON.stringify(reviewsList);
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      payload.reviews_json = JSON.stringify(reviewsList);

      try {
        const response = await fetch('/admin/media/save', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (data.success) {
          if (btnTop) btnTop.textContent = 'Save All Media Settings';
          if (btnBottom) btnBottom.textContent = 'Save All Media Settings';
          if (statusMsg) {
            statusMsg.style.color = '#92e6a3';
            statusMsg.textContent = '✓ Saved! Live media stream & reviews updated on the storefront.';
          }
          if (data.reviews) {
            reviewsList = data.reviews;
            renderReviewsEditor();
          }

          // Remove any existing media banner and show fresh confirmation
          const existingBanner = document.getElementById('alert-banner-media');
          if (existingBanner) existingBanner.remove();

          const banner = document.createElement('aside');
          banner.className = 'alert-banner';
          banner.id = 'alert-banner-media';
          banner.style.cssText = 'border-color:#92e6a3; color:#92e6a3; background:rgba(146,230,163,.15);';
          banner.innerHTML = `
            <span>✓ Website media URLs &amp; poster images have been saved and are live on the storefront!</span>
            <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;color:#92e6a3;font-size:1.2rem;cursor:pointer;">✕</button>
          `;
          document.querySelector('.wrap').prepend(banner);
        } else {
          throw new Error(data.error || 'Failed to save media settings');
        }
      } catch (err) {
        console.error('Media save error:', err);
        // Fallback to standard form submission
        form.submit();
      }
    }

    // Auto-open if edit query parameter was provided
    window.addEventListener('DOMContentLoaded', () => {
      if (initialEditId) {
        openEditModal(initialEditId);
      }
      updateHeroPreview();
      updateShortPreview();
      renderReviewsEditor();
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    // Page Resilience: Redirect to homepage if a fatal page error occurs
    window.addEventListener('error', (event) => {
      if (event && event.error && event.error.redirectHome) {
        window.location.href = '/';
      }
    });
  </script>
</body>
</html>
